#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mmv {
    acceleration-exponent = <4>;
    time-to-max-speed-ms = <50>;
};

/ {
    behaviors {
        hm: hm {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            flavor = "tap-preferred";
        };

        capswordus: capswordus {
            compatible = "zmk,behavior-caps-word";
            label = "CAPSWORDUS";
            #binding-cells = <0>;
            continue-list = <MINUS UNDERSCORE>;
        };

        hm_layer: hm_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_LAYER";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <50>;
            flavor = "balanced";
        };

        layer_bal: layer_bal {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_BAL";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <100>;
            require-prior-idle-ms = <100>;
            flavor = "tap-preferred";
        };

        hold_lt: hold_lt {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_LT";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
        };

        media_td: media_td {
            compatible = "zmk,behavior-tap-dance";
            label = "MEDIA_TD";
            #binding-cells = <0>;
            bindings = <&kp C_PP>, <&kp C_NEXT>, <&kp C_PREVIOUS>;
        };
    };

    combos {
        compatible = "zmk,combos";

        cwcombo {
            bindings = <&caps_word>;
            key-positions = <4 7>;
        };

        lp {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <0 11>;
        };

        lbr {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <12 23>;
        };

        lb {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <24 35>;
        };

        esccomb {
            bindings = <&kp ESCAPE>;
            key-positions = <16 19>;
        };

        homerow {
            bindings = <&kp RG(RS(SPACE))>;
            key-positions = <28 31>;
        };

        mouse {
            bindings = <&tog 4>;
            key-positions = <1 10>;
        };

        entercomb {
            bindings = <&kp ENTER>;
            key-positions = <20 15>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ---------------------------------------------------------------------------------------------------------------------------------
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                                          |  Y   |  U    |  I    |  O   |   P   |   \  |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                                          |  H   |  J    |  K    |  L   |   ;   |   '  |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   | L SHIFT | L SHIFT |  | LAYER 1 | L SHIFT |  N   |  M    |  ,    |  .   |   /   | CTRL |
            //                     | GUI  | DEL  | RET  |  SPACE  |   ESC   |  |   RET   |  SPACE  | TAB  | BSPC  | R-ALT |

            bindings = <
&none  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &none  &trans  &kp A  &hm LALT S  &hm LGUI D  &hm LCTRL F  &hm_layer 2 G  &hm_layer 2 H  &hm RCTRL J  &hm LGUI K  &hm RALT L  &kp SEMICOLON  &none  &none  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &none  &kp ESCAPE  &hold_lt 3 SPACE  &hold_lt 3 TAB  &hold_lt 3 BACKSPACE  &kp LEFT_SHIFT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        nav {
            bindings = <
&trans  &kp RG(RS(Q))  &kp RG(E)  &kp RG(E)  &kp RG(R)  &trans  &kp LC(LA(LG(LS(N1))))  &kp LC(LA(LG(LS(N2))))  &kp LC(LA(LG(LS(N3))))  &kp LS(LC(LA(LG(N4))))  &kp LC(LA(LG(LS(N5))))  &kp LS(LC(LA(LG(N6))))  &kp LS(LC(LALT))  &kp LC(LSHFT)  &kp RG(S)  &kp RC(TAB)  &kp RG(F)  &kp RA(TAB)  &kp LC(LA(LG(LS(H))))  &kp LC(LA(LG(LS(J))))  &kp LC(LA(LG(LS(K))))  &kp LC(LA(LG(LS(L))))  &kp LC(LSHFT)  &kp LCTRL  &trans  &trans  &trans  &kp RC(RS(TAB))  &kp RG(TAB)  &kp RA(RS(TAB))  &kp LC(LA(LG(LS(LEFT))))  &kp LC(LA(LG(LS(UP_ARROW))))  &kp LC(LA(LS(DOWN_ARROW)))  &kp LC(LA(LG(LS(RIGHT))))  &kp LC(LA(LG(LS(LEFT))))  &kp RSHFT  &kp LC(LA(LG(LS(UP))))  &kp LC(LA(LG(LS(RIGHT))))  &trans  &trans  &trans
            >;

            label = "nav";
        };

        upper {
            bindings = <
&trans  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &trans  &trans  &kp F1  &kp LALT  &kp LEFT_GUI  &kp LEFT_CONTROL  &kp RIGHT_PARENTHESIS  &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &kp F12  &trans  &trans  &kp RGUI  &kp C_MUTE  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &media_td  &trans  &kp RIGHT_CONTROL  &kp RIGHT_GUI  &kp RALT  &kp RSHIFT  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            label = "upper";
        };

        num {
            label = "num";
            bindings = <
&none  &kp PLUS  &kp UNDER  &kp GRAVE  &kp BACKSLASH  &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp N7  &kp N8  &kp N9  &kp DOUBLE_QUOTES  &none  &trans  &kp CARET  &hm LALT DOLLAR  &hm LGUI EQUAL  &hm LCTRL MINUS  &kp LEFT_PARENTHESIS  &kp LEFT_BRACKET  &hm RCTRL NUMBER_4  &hm LGUI N5  &hm RALT NUMBER_6  &kp SQT  &none  &none  &kp DOUBLE_QUOTES  &kp HASH  &kp AT_SIGN  &kp BACKSLASH  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACKET  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp N0  &none  &kp DEL  &kp ENTER  &trans  &trans  &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        mouse {
            bindings = <
&trans  &trans  &trans  &trans  &msc SCRL_UP  &trans  &trans  &msc SCRL_UP  &trans  &trans  &trans  &trans  &trans  &trans  &msc SCRL_LEFT  &msc SCRL_LEFT  &msc SCRL_RIGHT  &msc SCRL_UP  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &mmv MOVE_RIGHT  &trans  &trans  &trans  &trans  &trans  &msc SCRL_DOWN  &trans  &mmv MOVE_X(400)  &mmv MOVE_Y(400)  &mmv MOVE_Y(-400)  &mmv MOVE_X(-400)  &trans  &trans  &trans  &mkp LCLK  &mkp MCLK  &mkp RCLK  &trans
            >;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
