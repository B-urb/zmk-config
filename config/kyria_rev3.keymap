#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1800  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default:

/ {
    behaviors {
        hm: hm {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <80>;
            flavor = "tap-preferred";
        };

        capswordminus: capswordminus {
            compatible = "zmk,behavior-caps-word";
            label = "CAPSWORDMINUS";
            #binding-cells = <0>;
            continue-list = <MINUS UNDERSCORE>;
        };

        layer_tap_bal: layer_tap_bal {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_BAL";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <100>;
        };

        lt_hold: lt_hold {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_HOLD";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
        };
    };

    combos {
        compatible = "zmk,combos";

        cwcombo {
            bindings = <&caps_word>;
            key-positions = <25 38>;
        };

        escaper {
            bindings = <&kp ESCAPE>;
            key-positions = <16 19>;
        };

        mouse_tog {
            bindings = <&tog 4>;
            key-positions = <10 1>;
        };

        backspacecombo {
            bindings = <&kp BACKSPACE>;
            key-positions = <6 7>;
        };

        homerow {
            bindings = <&kp LG(LS(SPACE))>;
            key-positions = <35 28>;
        };

        tabs {
            bindings = <&kp TAB>;
            key-positions = <13 14>;
        };

        entermenter {
            bindings = <&kp ENTER>;
            key-positions = <15 20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ---------------------------------------------------------------------------------------------------------------------------------
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                                          |  Y   |  U    |  I    |  O   |   P   |   \  |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                                          |  H   |  J    |  K    |  L   |   ;   |   '  |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   | L SHIFT | L SHIFT |  | LAYER 1 | L SHIFT |  N   |  M    |  ,    |  .   |   /   | CTRL |
            //                     | GUI  | DEL  | RET  |  SPACE  |   ESC   |  |   RET   |  SPACE  | TAB  | BSPC  | R-ALT |

            bindings = <
&trans  &kp Q  &kp W       &kp E       &kp R        &kp T                                                                           &kp Y               &kp U        &kp I       &kp O       &kp P          &trans
&trans  &kp A  &hm LALT S  &hm LGUI D  &hm LCTRL F  &layer_tap_bal 2 G                                                              &layer_tap_bal 2 H  &hm RCTRL J  &hm LGUI K  &hm RALT L  &kp SEMICOLON  &trans
&none   &kp Z  &kp X       &kp C       &kp V        &kp B               &kp LSHFT  &kp LSHFT       &mo 0                 &kp LSHFT  &kp N               &kp M        &kp COMMA   &kp DOT     &kp FSLH       &trans
                           &none       &mo 3        &kp ESCAPE          &kp SPACE  &lt_hold 1 TAB  &lt_hold 1 BACKSPACE  &kp LSHFT  &lt 2 TAB           &kp BSPC     &kp RALT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        layer_num {
            label = "layer_num";
            bindings = <
&trans  &kp UNDERSCORE     &kp PLUS        &kp GRAVE       &kp BACKSLASH    &kp LEFT_BRACE                                             &kp RIGHT_BRACE    &kp N7              &kp N8       &kp N9             &kp PLUS          &trans
&trans  &hm LGUI PLUS      &hm LALT UNDER  &hm LGUI EQUAL  &hm LCTRL MINUS  &kp LEFT_PARENTHESIS                                       &kp LEFT_BRACKET   &hm RCTRL NUMBER_4  &hm RGUI N5  &hm RALT NUMBER_6  &kp SINGLE_QUOTE  &trans
&trans  &kp DOUBLE_QUOTES  &kp HASH        &kp AT_SIGN     &kp ENTER        &kp RIGHT_PARENTHESIS  &kp F7     &kp F8  &kp F9  &kp F10  &kp RIGHT_BRACKET  &kp N1              &kp N2       &kp N3             &kp N0            &trans
                                           &trans          &trans           &kp DEL                &kp ENTER  &trans  &trans  &trans   &trans             &trans              &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        upper {
            bindings = <
&trans  &kp F2        &kp F3        &kp F4        &kp F5            &kp F6                                                 &kp F7          &kp F8             &kp F9         &kp F10    &kp F11   &trans
&trans  &kp F1        &kp LEFT_ALT  &kp LEFT_GUI  &kp LEFT_CONTROL  &kp RIGHT_PARENTHESIS                                  &kp LEFT_ARROW  &kp DOWN           &kp UP_ARROW   &kp RIGHT  &kp F12   &trans
&trans  &kp LEFT_GUI  &kp LALT      &kp RCTRL     &kp RSHFT         &capswordminus         &trans  &trans  &trans  &trans  &trans          &kp RIGHT_CONTROL  &kp RIGHT_GUI  &kp RALT   &kp RGUI  &trans
                                    &trans        &trans            &trans                 &trans  &trans  &trans  &trans  &trans          &trans             &trans
            >;

            label = "upper";
        };

        control {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                                  &trans  &trans      &trans        &trans  &trans  &bt BT_CLR_ALL
&trans  &trans  &trans  &trans  &trans  &trans                                  &trans  &trans      &trans        &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &bt BT_NXT  &out OUT_TOG  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans
            >;
        };

        mouse {
            bindings = <
&trans  &trans  &trans  &trans          &trans           &trans                                         &trans          &msc SCRL_UP    &trans        &trans           &trans  &trans
&trans  &trans  &trans  &msc SCRL_LEFT  &msc SCRL_RIGHT  &trans                                         &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans  &trans
&trans  &trans  &trans  &trans          &trans           &trans  &trans  &trans     &trans    &trans    &trans          &msc SCRL_DOWN  &trans        &trans           &trans  &trans
                        &trans          &trans           &trans  &trans  &mkp MCLK  &mkp MB1  &mkp MB2  &trans          &trans          &trans
            >;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
