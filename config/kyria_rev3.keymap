#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1800  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default:

/ {
    behaviors {
        hm: hm {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <220>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
        };

        capswordminus: capswordminus {
            compatible = "zmk,behavior-caps-word";
            label = "CAPSWORDMINUS";
            #binding-cells = <0>;
            continue-list = <MINUS UNDERSCORE>;
        };

        layer_tap_bal: layer_tap_bal {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_BAL";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <100>;
        };

        lt_hold: lt_hold {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_HOLD";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
        };

        media_td: media_td {
            compatible = "zmk,behavior-tap-dance";
            label = "MEDIA_TD";
            #binding-cells = <0>;
            bindings = <&kp C_PP>, <&kp C_NEXT>, <&kp C_PREVIOUS>;
        };

        thumb_tap: thumb_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "THUMB_TAP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <220>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
        };

        thumb_tab_sticky: thumb_tab_sticky {
            compatible = "zmk,behavior-hold-tap";
            label = "THUMB_TAB_STICKY";
            bindings = <&kp>, <&sk>;

            #binding-cells = <2>;
            tapping-term-ms = <220>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <0>;
            flavor = "tap-preferred";
        };
    };

    combos {
        compatible = "zmk,combos";

        cwcombo {
            bindings = <&caps_word>;
            key-positions = <25 38>;
        };

        mouse_tog {
            bindings = <&tog 3>;
            key-positions = <10 1>;
        };

        homerow {
            bindings = <&kp LG(LS(SPACE))>;
            key-positions = <35 28>;
        };

        entermenter {
            bindings = <&kp ENTER>;
            key-positions = <15 20>;
            timeout-ms = <100>;
            require-prior-idle-ms = <125>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ---------------------------------------------------------------------------------------------------------------------------------
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                                          |  Y   |  U    |  I    |  O   |   P   |   \  |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                                          |  H   |  J    |  K    |  L   |   ;   |   '  |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   | L SHIFT | L SHIFT |  | LAYER 1 | L SHIFT |  N   |  M    |  ,    |  .   |   /   | CTRL |
            //                     | GUI  | DEL  | RET  |  SPACE  |   ESC   |  |   RET   |  SPACE  | TAB  | BSPC  | R-ALT |

            bindings = <
&trans  &kp Q                    &kp W  &kp E  &kp R  &kp T                                                                                                                             &kp Y                      &kp U  &kp I      &kp O    &kp P                  &trans
&trans  &kp A                    &kp S  &kp D  &kp F  &kp G                                                                                                                             &kp H                      &kp J  &kp K      &kp L    &kp SEMICOLON          &trans
&none   &thumb_tap Z LEFT_SHIFT  &kp X  &kp C  &kp V  &kp B           &none                   &none       &none                              &none                                      &kp N                      &kp M  &kp COMMA  &kp DOT  &hm RIGHT_SHIFT SLASH  &trans
                                        &none  &none  &lt_hold 2 TAB  &layer_tap_bal 1 SPACE  &kp ESCAPE  &thumb_tap LEFT_CONTROL BACKSPACE  &thumb_tab_sticky LEFT_COMMAND LEFT_SHIFT  &thumb_tap LEFT_ALT ENTER  &none  &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        layer_num {
            label = "layer_num";
            bindings = <
&trans  &kp NUMBER_1    &kp NUMBER_2     &kp NUMBER_3    &kp NUMBER_4     &kp N5                                                   &kp NUMBER_6       &kp N7    &kp N8  &kp N9     &kp N0                      &trans
&trans  &kp TILDE       &hm LALT DOLLAR  &hm LGUI EQUAL  &hm LCTRL MINUS  &kp LEFT_PARENTHESIS                                     &kp LEFT           &kp DOWN  &kp UP  &kp RIGHT  &kp SINGLE_QUOTE            &trans
&trans  &kp LEFT_SHIFT  &kp SQT          &kp CARET       &kp DOLLAR       &kp LEFT_BRACKET      &none      &none   &none   &none   &kp RIGHT_BRACKET  &kp N1    &kp N2  &kp EQUAL  &hm RSHFT NON_US_BACKSLASH  &trans
                                         &trans          &trans           &kp DEL               &kp ENTER  &trans  &trans  &trans  &trans             &trans    &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        upper {
            bindings = <
&trans  &kp F2          &kp F3        &kp F4             &kp F5            &kp F6                                     &kp F7           &kp F8      &kp F9         &kp F10         &kp F11          &trans
&trans  &kp F1          &kp LEFT_ALT  &kp LEFT_GUI       &kp LEFT_CONTROL  &kp END                                    &kp PRINTSCREEN  &sk RCTRL   &sk RIGHT_GUI  &sk RIGHT_ALT   &kp F12          &trans
&trans  &kp LEFT_SHIFT  &kp C_MUTE    &kp C_VOLUME_DOWN  &kp C_VOLUME_UP   &media_td  &trans  &trans  &trans  &trans  &trans           &bt BT_NXT  &out OUT_TOG   &bt BT_CLR_ALL  &kp RIGHT_SHIFT  &trans
                                      &trans             &trans            &trans     &trans  &trans  &trans  &trans  &trans           &trans      &trans
            >;

            label = "upper";
        };

        mouse {
            bindings = <
&trans  &trans  &trans  &trans          &trans           &trans                                         &trans          &msc SCRL_UP    &trans        &trans           &trans  &trans
&trans  &trans  &trans  &msc SCRL_LEFT  &msc SCRL_RIGHT  &trans                                         &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans  &trans
&trans  &trans  &trans  &trans          &trans           &trans  &trans  &trans     &trans    &trans    &trans          &msc SCRL_DOWN  &trans        &trans           &trans  &trans
                        &trans          &trans           &trans  &trans  &mkp MCLK  &mkp MB1  &mkp MB2  &trans          &trans          &trans
            >;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
